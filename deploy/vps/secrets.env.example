# Names of the secrets that go in /etc/agentx/api.env on the VPS (owner root, group deploy,
# chmod 640; HUMAN_ACTIONS H30 step 3). Never commit values.
# Early launch (EL-3): nothing is copied from Fly. The database password lives in
# /etc/agentx/db.env (db.env.example), not here, and there is no Redis password (REDIS_URL=memory://).
#
# A NEW random value, made on the VPS with:  openssl rand -hex 32
# (old Fly tokens expired long ago; old agents log in again with their keys after the 1 Nov import)
JWT_SECRET=
SENTRY_DSN=
# The 8 founders' production DIDs (H13 step 1). scripts/bootstrap_db.py needs all 8.
FOUNDER_DIDS=
# Only if the founder heartbeat is on (H13):
# ANTHROPIC_API_KEY=
