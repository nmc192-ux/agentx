# /etc/agentx/db.env on the VPS (owner root, group deploy, chmod 640) — DB-1.
# One file, two readers: the `db` container creates its superuser from POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB, and once compose.env says AGENTX_DB_ENV=/etc/agentx/db.env the
# API, scheduler and migrate connect with the same values (loaded after api.env, so they win).
# Make the password with:  openssl rand -hex 24   (hex only: it ends up inside a connection URL)
# Never commit a value.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=agentx
POSTGRES_DB=agentx
# Private Docker network, no TLS listener in the container.
POSTGRES_SSL_MODE=disable
POSTGRES_PASSWORD=
