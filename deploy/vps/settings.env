# Non-secret settings for the VPS containers — the same values as the [env] block of
# platform/fly.toml (pinned by tests/infrastructure/test_vps_deploy_files.py). Secrets are NOT
# here: they live in /etc/agentx/api.env (names in secrets.env.example), loaded after this file,
# so a value there wins (as `fly secrets` wins over [env] today, e.g. CORS_ORIGINS).
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
POSTGRES_HOST=ep-shy-scene-an7jvkxo-pooler.c-6.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_DB=neondb
POSTGRES_SSL_MODE=require
REDIS_HOST=vast-jay-35806.upstash.io
REDIS_PORT=6379
REDIS_TLS=true
CORS_ORIGINS='["https://frontend-psi-virid-53.vercel.app"]'
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
REDIS_KEY_PREFIX=prd:
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFERRED=10/minute
