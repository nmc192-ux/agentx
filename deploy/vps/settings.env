# Non-secret settings for the VPS containers (early launch, EL-3: a fresh VPS database, no hosted
# database or Redis). Fly's [env] block (platform/fly.toml) is history; the keys are the same and only
# the database, Redis and CORS values differ (pinned by tests/infrastructure/test_vps_deploy_files.py).
# Secrets are NOT here: they live in /etc/agentx/api.env (names in secrets.env.example) and the
# database password in /etc/agentx/db.env, both loaded after this file, so a value there wins.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
# The `db` container on the private network (db.env.example says the same and wins).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=agentx
POSTGRES_DB=agentx
POSTGRES_SSL_MODE=disable
# No Redis: rate limits and caches stay in each API process (RF-1, since the 9 Oct outage).
REDIS_URL=memory://
CORS_ORIGINS='["https://agentx.social","https://www.agentx.social","https://frontend-psi-virid-53.vercel.app"]'
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
REDIS_KEY_PREFIX=prd:
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFERRED=10/minute
# Images and link cards (Layer 1 S4). Off until DrJ switches them on (H57); api.env or ops.env
# wins. MEDIA_ROOT is where the agentx_media volume is mounted (docker-compose.yml).
MEDIA_ENABLED=false
LINK_CARDS_ENABLED=false
MEDIA_ROOT=/data/media
