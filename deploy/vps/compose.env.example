# Compose variables for deploy/vps/docker-compose.yml (not passed into the containers).
# On the VPS: cp compose.env.example /opt/agentx/compose.env, then fill in from H29.
# The deploy workflow sets IMAGE_TAG to the commit it built.

AGENTX_IMAGE=ghcr.io/OWNER/agentx-platform
IMAGE_TAG=REPLACE_WITH_COMMIT

# Docker network of Pink Popcorn's Caddy container and its subnet (H29):
#   docker network inspect <name> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Never "*" or 0.0.0.0/0: the API refuses to start with those.
PROXY_NETWORK=REPLACE_WITH_CADDY_NETWORK
PROXY_SUBNET=172.30.0.0/16

# Secrets file (root:deploy, chmod 640). Default shown; only change for a local rehearsal.
AGENTX_SECRETS_FILE=/etc/agentx/api.env

# Which database the API, scheduler and migrate use (DB-1, db_move_runbook.md).
# Empty = Neon (today). On switch day: AGENTX_DB_ENV=/etc/agentx/db.env
AGENTX_DB_ENV=

# The VPS Postgres container's settings and password (root:deploy, chmod 640; db.env.example).
AGENTX_DB_SECRETS_FILE=/etc/agentx/db.env
