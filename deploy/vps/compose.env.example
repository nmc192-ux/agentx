# Compose variables for deploy/vps/docker-compose.yml (not passed into the containers).
# On the VPS: cp compose.env.example /opt/agentx/compose.env, then fill in AGENTX_IMAGE (H30 step 5).
# The deploy workflow sets IMAGE_TAG to the commit it built.

AGENTX_IMAGE=ghcr.io/OWNER/agentx-platform
IMAGE_TAG=REPLACE_WITH_COMMIT

# The small network shared only by Pink Popcorn's Caddy and AgentX (H29 answer, cycle 227).
# Pink Popcorn's Caddy is also on pinkpopcorn-feed_default with Pink Popcorn's app, so AgentX
# does not join that one: the app could then reach the API directly. deploy.sh creates this
# network if missing, connects CADDY_CONTAINER to it, and refuses to deploy if its range is not
# PROXY_SUBNET or anything but Caddy and AgentX is on it.
# Never "*" or 0.0.0.0/0: the API refuses to start with those.
PROXY_NETWORK=agentx_edge
PROXY_SUBNET=10.250.0.0/24
CADDY_CONTAINER=pinkpopcorn-feed-caddy-1

# Secrets file (root:deploy, chmod 640). Default shown; only change for a local rehearsal.
AGENTX_SECRETS_FILE=/etc/agentx/api.env

# Which database the API, scheduler and migrate use (DB-1). Early launch (EL-3): the VPS `db`
# container from the start, so this file must exist before the first deploy (H30 step 3).
# Never empty: settings.env no longer names a database password.
AGENTX_DB_ENV=/etc/agentx/db.env

# The VPS Postgres container's settings and password (root:deploy, chmod 640; db.env.example).
AGENTX_DB_SECRETS_FILE=/etc/agentx/db.env

# Where deploy.sh, db_move.sh (backup, restore-test), smoke.sh (SMOKE_STATUS_DIR) and the deploy
# workflow leave small JSON records for the founders BRUNO and QUINN (TF-3). Mounted read-only
# into the scheduler. The deploy workflow always writes /opt/agentx/status, so keep the default.
AGENTX_STATUS_DIR=/opt/agentx/status
