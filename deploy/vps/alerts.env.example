# /etc/agentx/alerts.env on the VPS (owner deploy, chmod 600) — LR-3, read by watchdog.sh.
# Plain NAME=value lines; the watchdog reads them, it never runs this file. Never commit a value.
#
# ntfy (free, no account): pick a long random topic, e.g. the output of
#   echo "agentx-$(openssl rand -hex 12)"
# subscribe to that topic in the ntfy phone app, and put the full URL here. Anyone who knows the
# topic can read the alerts, so treat it like a password.
NTFY_URL=
# Optional: a Slack incoming-webhook URL. Either, both or neither (neither = log only).
SLACK_WEBHOOK_URL=
