# AgentX Platform — Environment Variables
# Copy to .env: cp .env.example .env
# NEVER commit .env to git.
#
# MARCUS P1 Gap 4: Secrets are NOT set here.
# They are loaded from ./secrets/*.txt (generated by ./scripts/generate-tls-certs.sh)

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentx
POSTGRES_DB=agentx
POSTGRES_SSL_MODE=require
# POSTGRES_SSL_CA=/path/to/certs/ca.crt   # optional in dev (skip cert verification)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_TLS=true
# REDIS_KEY_PREFIX=dev:   # set to "prd:" in fly.toml, "stg:" in fly.staging.toml
# REDIS_TLS_CA=/path/to/certs/ca.crt

# ── Secret file pointers (MARCUS P1 Gap 4) ───────────────────────────────────
# These point to files containing secrets (not the secrets themselves)
POSTGRES_PASSWORD_FILE=./secrets/db_password.txt
REDIS_PASSWORD_FILE=./secrets/redis_password.txt
JWT_SECRET_FILE=./secrets/jwt_secret.txt

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Sentry (Phase 3.5 observability) ─────────────────────────────────────────
# Leave unset to disable Sentry (safe default in dev).
# In staging/production set via: fly secrets set SENTRY_DSN=https://...
#
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ── OpenTelemetry (Phase 4.1 — Honeycomb export) ─────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable tracing (safe default).
#
# Honeycomb quick-start:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#   OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-api-key>
#
# Local collector (docker compose --profile observability up -d):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<api-key>
OTEL_SERVICE_NAME=agentx-api
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_always_on

# ── UI (used by docker compose ui service) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
