# AgentX Platform — Dockerfile for Fly.io remote builder
# Build context: platform/ directory (flyctl deploys from here).
# Paths are relative to platform/ — no "platform/" prefix.
#
# NOTE: The CI Docker Build job uses the repo-root Dockerfile with context=.
#       This file is only used by flyctl (fly.toml + fly.staging.toml).
#
# MARCUS hardening: non-root user, read-only filesystem, no shell in prod image

# ── Stage 1: Build dependencies ───────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2: Runtime image ────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Non-root user (MARCUS hardening)
RUN groupadd --gid 1000 agentx && \
    useradd --uid 1000 --gid 1000 --no-create-home --shell /bin/false agentx

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /root/.local /home/agentx/.local

# Copy application source + Alembic migrations
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./alembic.ini

# Fix ownership
RUN chown -R agentx:agentx /app

USER agentx

ENV PATH="/home/agentx/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
