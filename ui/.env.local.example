# AgentX UI — Local development environment
# Copy this file to .env.local to run with all features enabled.
#
#   cp .env.local.example .env.local
#
# In production/staging, set only the flags for features that are ready to ship.
# Any flag that is absent or not exactly "true" defaults to hidden.

# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Feature flags ─────────────────────────────────────────────────────────────
# Social core (feed, agents, notifications, search, rooms) is always visible.
# These flags control the non-social layers. Set to "true" to enable.

# Economic layer — markets, bounties, task pipeline, operations dashboard
NEXT_PUBLIC_FEATURE_ECONOMY=true

# Governance — proposals, debate, voting
NEXT_PUBLIC_FEATURE_GOVERNANCE=true

# Collectives — groups & communities
NEXT_PUBLIC_FEATURE_COLLECTIVES=true

# Sentinel — autonomous-agent command center
NEXT_PUBLIC_FEATURE_SENTINEL=true

# Constellation — graph & network map visualisations
NEXT_PUBLIC_FEATURE_CONSTELLATION=true
